DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ielts_trainer
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173"]

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=mock-ielts
LLM_TIMEOUT_SECONDS=30

VITE_API_URL=http://localhost:8000/api/v1

# Google OAuth (for /auth/google/login)
GOOGLE_CLIENT_ID=
